# ---------------------------------------------------------------------------
# QuickBooks Online (DEL-10 Money zone). Read-only financials.
#
# WHERE EACH VAR LIVES:
#   - Vercel (this app): everything below EXCEPT QBO_CLIENT_SECRET. The Vercel
#     surface only builds the consent redirect + receives the callback; it never
#     calls Intuit (no static egress IP), so it never needs the client secret.
#   - KVM2 / n8n rail: QBO_CLIENT_ID + QBO_CLIENT_SECRET + QBO_PROXY_SECRET +
#     SUPABASE_SECRET_KEY. The rail is the ONLY surface that calls Intuit (from
#     the whitelisted static IP 72.60.226.53) and the only place the secret and
#     the tokens live. See docs/qbo/kvm2-rail.md.
# ---------------------------------------------------------------------------
QBO_CLIENT_ID=xxx                                  # Intuit app client id (both surfaces)
QBO_CLIENT_SECRET=xxx                              # KVM2 RAIL ONLY -- never set on Vercel
QBO_ENVIRONMENT=sandbox                            # sandbox | production (prod keys pending Intuit approval)
QBO_REDIRECT_URI=https://mate.auto-mate.business/api/qb/callback
# CSRF signing for the OAuth `state`. Falls back to MATE_SESSION_SECRET if unset.
QBO_STATE_SECRET=
# KVM2 n8n "QBO Live Proxy" token-exchange webhook + shared secret. The callback
# route POSTs the authorization code here; the rail does the exchange + stores
# tokens. Unset => the connect flow reports 'exchange_failed' (fails closed).
QBO_RAIL_EXCHANGE_URL=https://n8n.auto-mate.business/webhook/qbo-exchange
QBO_PROXY_SECRET=                                  # x-proxy-secret shared with the rail

# ---------------------------------------------------------------------------
# Instant First Responder Demo (edge functions + /api/demo/start)
# ---------------------------------------------------------------------------
# Set on the Supabase Edge Functions runtime (demo-voice / demo-sms) AND, where
# noted, on the Next app. See README "Demo go-live" before flipping this live.

# REQUIRED for go-live. Base64 Ed25519 public key from the Telnyx portal. Webhook
# signatures FAIL CLOSED in production when this is unset (verify.ts): every
# request is rejected. Leave unset ONLY for local dev (dev-skip).
TELNYX_PUBLIC_KEY=

# Telnyx Messaging (outbound text-back). Unset => sends are skipped (no-op).
TELNYX_API_KEY=
DEMO_TELNYX_NUMBER=+1xxxxxxxxxx            # the ONE shared demo number, E.164
TELNYX_MESSAGING_PROFILE_ID=              # optional; explicit 10DLC/long-code routing

# Demo reply model (BYOK via Portkey). Default model is google/gemini-2.5-flash,
# so GEMINI_API_KEY is the upstream key. See README ops for the Portkey failover note.
GEMINI_API_KEY=
PORTKEY_BASE_URL=https://portkey.auto-mate.business
# DEMO_REPLY_MODEL=google/gemini-2.5-flash          # override to failover to another provider
# DEMO_REPLY_MAX_TOKENS=800                          # budget must cover Gemini's hidden
#                                                    # reasoning tokens + the visible SMS;
#                                                    # too low (e.g. 300) truncates the reply.
# LLM_PORTKEY_BYPASS=1                               # see README: NO-OP unless model is non-Gemini

# --- Voicemail-with-transcription + text-back buffer (Flow A) ---
# Auth token for the VOICE webhook + Record `action` callback + the call-lifecycle
# StatusCallback (demo-call-status, the hangup catch-all) -- all three share this ?k=
# token (same voice trust domain; Telnyx TeXML posts don't Ed25519-sign). FAILS
# CLOSED when unset in prod (every voice-path webhook 401s).
DEMO_VOICE_TOKEN=
# demo-voice's TeXML records the caller with transcription on and points the
# transcribe callback at demo-transcribe. This token authenticates that callback
# (?k= in the URL); Telnyx TeXML transcribe callbacks don't Ed25519-sign, so the
# token IS the auth. FAILS CLOSED when unset in prod (every callback 401s).
DEMO_TRANSCRIBE_TOKEN=
# Text-back buffer: the NO-VM generic text-back is SCHEDULED (Telnyx send_at) to land
# ~N seconds after the call so it feels like a real callback, not an instant bot.
# Telnyx honours send_at to ~1-minute accuracy. 0/unset-as-0 => send immediately.
DEMO_TEXTBACK_DELAY_SECONDS=30
# HANGUP CATCH-ALL delay (demo-call-status safety net). A caller who hangs up while
# ringing or during the greeting (before the Record beep) reaches neither the Record
# action nor the transcribe callback -> no text today. The StatusCallback backstops
# that: it DEFERS this many seconds, THEN claims the one-text slot (claim-at-fire). A
# real voicemail's REFERENCING text (transcribe, ~10-20s post-hangup) and the no-VM
# action text both claim FIRST, so the catch-all no-ops for them and only fires for a
# true early hangup. MUST exceed transcription latency + the send_at buffer; default
# 45. Non-positive/garbage falls back to 45 (0 would race the referencing path).
DEMO_HANGUP_CATCHALL_DELAY_SECONDS=45
# Optional: the public base URL Telnyx posts the TeXML callbacks to. Defaults to
# ${SUPABASE_URL}/functions/v1 (the edge base) when unset. Set only to front the
# functions with a custom domain later.
# DEMO_FUNCTIONS_BASE=https://jeqnvdlfybpmbovywknz.supabase.co/functions/v1

# Production detection for fail-closed signature verification. DENO_DEPLOYMENT_ID is
# injected automatically by Supabase Edge; set DEMO_ENV=production to force it on
# other hosts. Leave unset locally to keep the documented dev-skip.
# DEMO_ENV=production

# Abuse guards (start route). Optional; sane defaults in code (guard.ts).
DEMO_MAX_PER_PHONE_PER_DAY=3
DEMO_MAX_PER_DAY=200

# Inbound-SMS caps (demo-sms edge fn). Optional; defaults in demo-sms/index.ts.
DEMO_SMS_MAX_REPLIES_PER_NUMBER_PER_DAY=20   # C2(a) per-sender qualify replies/day
DEMO_SMS_MAX_PER_DAY=500                      # C2(b) global outbound-SMS breaker/day
DEMO_CODE_MAX_ATTEMPTS_PER_NUMBER_PER_DAY=10  # H4 inbound code attempts/sender/day
