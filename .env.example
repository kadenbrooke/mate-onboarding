# Supabase (business project jeqnvdlfybpmbovywknz)
NEXT_PUBLIC_SUPABASE_URL=https://jeqnvdlfybpmbovywknz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx           # server-only, bypasses RLS

# Mate concierge + sandbox model (cost-first; pick one provider)
OPENAI_API_KEY=sk-xxx                        # gpt-4o-mini tier
# or ANTHROPIC_API_KEY / GEMINI_API_KEY

# Google Business OAuth (later task)
GOOGLE_OAUTH_CLIENT_ID=xxx
GOOGLE_OAUTH_CLIENT_SECRET=xxx
GOOGLE_OAUTH_REDIRECT_URI=https://<app-domain>/api/connect/google/callback

# ---------------------------------------------------------------------------
# Instant First Responder Demo (edge functions + /api/demo/start)
# ---------------------------------------------------------------------------
# Set on the Supabase Edge Functions runtime (demo-voice / demo-sms) AND, where
# noted, on the Next app. See README "Demo go-live" before flipping this live.

# REQUIRED for go-live. Base64 Ed25519 public key from the Telnyx portal. Webhook
# signatures FAIL CLOSED in production when this is unset (verify.ts): every
# request is rejected. Leave unset ONLY for local dev (dev-skip).
TELNYX_PUBLIC_KEY=

# Telnyx Messaging (outbound text-back). Unset => sends are skipped (no-op).
TELNYX_API_KEY=
DEMO_TELNYX_NUMBER=+1xxxxxxxxxx            # the ONE shared demo number, E.164
TELNYX_MESSAGING_PROFILE_ID=              # optional; explicit 10DLC/long-code routing

# Demo reply model (BYOK via Portkey). Default model is google/gemini-3-flash-preview,
# so GEMINI_API_KEY is the upstream key. See README ops for the Portkey failover note.
GEMINI_API_KEY=
PORTKEY_BASE_URL=https://portkey.auto-mate.business
# DEMO_REPLY_MODEL=google/gemini-3-flash-preview   # override to failover to another provider
# LLM_PORTKEY_BYPASS=1                              # see README: NO-OP unless model is non-Gemini

# Production detection for fail-closed signature verification. DENO_DEPLOYMENT_ID is
# injected automatically by Supabase Edge; set DEMO_ENV=production to force it on
# other hosts. Leave unset locally to keep the documented dev-skip.
# DEMO_ENV=production

# Abuse guards (start route). Optional; sane defaults in code (guard.ts).
DEMO_MAX_PER_PHONE_PER_DAY=3
DEMO_MAX_PER_DAY=200

# Inbound-SMS caps (demo-sms edge fn). Optional; defaults in demo-sms/index.ts.
DEMO_SMS_MAX_REPLIES_PER_NUMBER_PER_DAY=20   # C2(a) per-sender qualify replies/day
DEMO_SMS_MAX_PER_DAY=500                      # C2(b) global outbound-SMS breaker/day
DEMO_CODE_MAX_ATTEMPTS_PER_NUMBER_PER_DAY=10  # H4 inbound code attempts/sender/day
